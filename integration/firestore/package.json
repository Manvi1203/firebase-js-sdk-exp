{
  "name": "firebase-firestore-integration-test",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "build:deps": "lerna run build --scope=\"@firebase/app\" --scope=\"@firebase/firestore\" --include-dependencies && npm run typings:public",
    "typings:public": "lerna run typings:public --scope=\"@firebase/app\" --scope=\"@firebase/firestore\"",
    "build:persistence": "yarn typings:public && INCLUDE_FIRESTORE_PERSISTENCE=true gulp compile-tests",
    "build:memory": "yarn typings:public && INCLUDE_FIRESTORE_PERSISTENCE=false gulp compile-tests",
    "test": "yarn test:memory",
    "test:all": "vitest run",
    "test:ci": "node ../../scripts/run_tests_in_ci.js -s test:all",
    "test:persistence": "yarn build:persistence && vitest run --project browser",
    "test:memory": "yarn build:memory && vitest run --project browser",
    "test:browser": "vitest run --project browser",
    "test:browser:watch": "vitest --project browser"
  },
  "dependencies": {
    "@firebase/app": "0.16.0",
    "@firebase/firestore": "4.17.0"
  },
  "devDependencies": {
    "@types/mocha": "9.1.1",
    "gulp": "5.0.1",
    "gulp-filter": "7.0.0",
    "gulp-replace": "1.1.4",
    "typescript": "5.5.4",
    "webpack-stream": "7.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
